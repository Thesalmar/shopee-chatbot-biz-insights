# 🏪 Shopee AI Seller Assistant - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# LINE Bot Configuration
# =============================================================================
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# =============================================================================
# OpenAI Configuration
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# Execution Mode - TEST (sandbox) or LIVE (production)
# =============================================================================
EXECUTION_MODE=TEST

# =============================================================================
# Shopee Test Environment (Sandbox) - Use for development/testing
# =============================================================================
TEST_SHOPEE_PARTNER_ID=your_test_partner_id_here
TEST_SHOPEE_PARTNER_KEY=your_test_partner_key_here

# Test Shop IDs by country - These are for sandbox testing
TEST_SHOP_ID_SG=your_test_shop_id_sg
TEST_SHOP_ID_MY=your_test_shop_id_my
TEST_SHOP_ID_PH=your_test_shop_id_ph
TEST_SHOP_ID_TH=your_test_shop_id_th
TEST_SHOP_ID_TW=your_test_shop_id_tw
TEST_SHOP_ID_VN=your_test_shop_id_vn

# =============================================================================
# Shopee Live Environment - Use for production deployment
# =============================================================================
LIVE_SHOPEE_PARTNER_ID=your_live_partner_id_here
LIVE_SHOPEE_PARTNER_KEY=your_live_partner_key_here

# Live Shop IDs by country - These are for production
LIVE_SHOP_ID_SG=your_live_shop_id_sg
LIVE_SHOP_ID_MY=your_live_shop_id_my
LIVE_SHOP_ID_PH=your_live_shop_id_ph
LIVE_SHOP_ID_TH=your_live_shop_id_th
LIVE_SHOP_ID_TW=your_live_shop_id_tw
LIVE_SHOP_ID_VN=your_live_shop_id_vn

# =============================================================================
# Server Configuration
# =============================================================================
TUNNEL_URL=https://your-domain.com
SHOP_NAME=your-shop-name

# =============================================================================
# Optional: Additional Configuration
# =============================================================================
# For custom configurations, add your variables below